{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": "./aplikacioni",
    "paths": {
      "@/*": ["./*", "./src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "aplikacioni/next-env.d.ts",
    "aplikacioni/.next/types/**/*.ts",
    "aplikacioni/**/*.ts",
    "aplikacioni/**/*.tsx"
  ],
  "exclude": ["aplikacioni/node_modules"]
}
